# 複製為 .env.development-file.local；金鑰需與 .env.development-api.local 的 Quote__File* 相同
FILE_HOST=127.0.0.1
FILE_PORT=5190
FILE_ROOT=file-server/data
FILE_CALLBACK_URL=http://127.0.0.1:5280/api/internal/files
# filesystem（本機）或 s3（MinIO）
STORAGE_DRIVER=filesystem
FILE_TOKEN_KEY=change-me-at-least-32-characters-long
FILE_CALLBACK_SECRET=change-me-16-chars-min
# STORAGE_DRIVER=s3 時：
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_BUCKET=quote-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
