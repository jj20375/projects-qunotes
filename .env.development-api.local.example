# 複製為 .env.development-api.local 並填入密碼
# 連 Mac 上的共用 MariaDB shared-mariadb（127.0.0.1:9529）；不要改連 3306 的 metat-vps-copy-db
DB_HOST=127.0.0.1
DB_PORT=9529
DB_NAME=quote_platform
DB_USER=quote_app
DB_PASSWORD=change-me
ConnectionStrings__Quote=Server=127.0.0.1;Port=9529;Database=quote_platform;User=quote_app;Password=change-me

# API 設定（本機開發）
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5280
# 至少 32 字元，可用 openssl rand -base64 48 產生
Quote__JwtKey=change-me-at-least-32-characters-long
Quote__RefreshCookieSecure=false
Quote__LoginCaptchaEnabled=true
Quote__BootstrapOnStart=true
Quote__SeedDemoData=true
# admin、demo-admin、demo-manager、demo-sales 的初始密碼（只在帳號不存在時使用，至少 8 碼）
Quote__BootstrapAdminPassword=change-me

# 檔案服務（需與 .env.development-file.local 相同）
Quote__FileTokenKey=change-me-at-least-32-characters-long
Quote__FileCallbackSecret=change-me-16-chars-min
# API 取用檔案本體（報價單 PDF 的 Logo）時呼叫的 file-server 位址
Quote__FileServerInternalUrl=http://127.0.0.1:5190

# 圖像識別匯入（選用）：兩個金鑰都留空則關閉此功能，其他功能不受影響。
# 供應商、模型、強度在 apps/api/QuotePlatform.Api/ai-settings.json（存檔即生效）。
# Claude：金鑰在 Claude Console 建立
Quote__AnthropicApiKey=
# Gemini：金鑰在 Google AI Studio 建立；建議用付費方案（免費方案的內容可能被 Google 用於改善產品）
Quote__GeminiApiKey=
