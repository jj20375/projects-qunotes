# 正式機的設定。複製為 deploy/.env.production 後填值（不進版控）。
#   開發機：./deploy/export-images.sh --environment=production
#   正式機：./deploy/deploy.sh --environment=production
#
# 首次移轉既有資料才加 --restore-backup；之後每次更新都不要帶（還原會 DROP 資料庫）。

DEPLOY_MODE=offline

SHARED_DB_CONTAINER=mariadb
SHARED_DB_NETWORK=mariadb-network

# 正式機的密碼與金鑰一律用新產生的值，不要與 demo 機共用；
# 不要含 ; $ ' " 等字元，建議用 openssl rand -hex 24 產生
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

JWT_KEY=change-me-at-least-32-characters-long
FILE_TOKEN_KEY=change-me-at-least-32-characters-long
FILE_CALLBACK_SECRET=change-me-16-chars-min
# 正式機一律走 HTTPS（前面的反向代理終止 TLS）
REFRESH_COOKIE_SECURE=true
# 掛在其他網站的子路徑下時才填（例如 /quote-platform/app，不可有結尾斜線）；正式機有獨立網域時留空。
APP_BASE_PATH=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

MINIO_ROOT_USER=quote
MINIO_ROOT_PASSWORD=change-me-at-least-8
DATA_ROOT=/srv/quote-platform/data

MIGRATE_ON_START=false
BOOTSTRAP_ON_START=false
# 全新資料庫（不還原備份）首次部署時必填，建立 admin 用；登入改密碼後清空
BOOTSTRAP_ADMIN_PASSWORD=

# 只綁本機，由前面的反向代理轉發（nginx 需求見 deploy/DEPLOY-FLOW.md）
WEB_BIND=127.0.0.1
# 信任的前置代理來源（單一 IP 或 CIDR）。前置 nginx 在同一台主機時，連線會從 Docker 閘道進來，
# 172.16.0.0/12 涵蓋 Docker 預設網段；部署完成時腳本會印出實際閘道，不在範圍內就改成那個 IP。
# 前置代理在別台機器時填它的 IP，例如 10.0.0.5/32。設錯的症狀是所有使用者 IP 都一樣。
TRUSTED_PROXY_CIDR=172.16.0.0/12
WEB_PORT=8096
IMAGE_TAG=latest
BACKUP_KEEP_DAYS=14
