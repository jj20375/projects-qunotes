# demo 機（Hyper-V Ubuntu）的設定。複製為 deploy/.env.demo 後填值（不進版控）。
#   開發機：./deploy/export-images.sh --environment=demo
#   demo 機：./deploy/deploy.sh --environment=demo

# demo 機不重新建置，載入開發機打包的映像
DEPLOY_MODE=offline

# 共用 MariaDB：同事維護的 central-mariadb（container mariadb，network mariadb-network）
SHARED_DB_CONTAINER=mariadb
SHARED_DB_NETWORK=mariadb-network

# quote_app 帳號密碼（API 使用），可自訂；ensure-shared-db.sh 會依這個值建立／更新。
# 密碼與金鑰不要含 ; $ ' " 等字元，建議用 openssl rand -hex 24 產生。
DB_PASSWORD=change-me
# 必須與 central-mariadb 的 MARIADB_ROOT_PASSWORD 相同（向維護者索取）
DB_ROOT_PASSWORD=change-me

# 至少 32 字元，可用 openssl rand -base64 48 產生
JWT_KEY=change-me-at-least-32-characters-long
FILE_TOKEN_KEY=change-me-at-least-32-characters-long
FILE_CALLBACK_SECRET=change-me-16-chars-min
# demo 機若直接用 http://<IP> 存取請維持 false；前面有 HTTPS 代理時改 true
REFRESH_COOKIE_SECURE=false

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# MinIO（本系統專用，不與美達特共用）
MINIO_ROOT_USER=quote
MINIO_ROOT_PASSWORD=change-me-at-least-8
# 目錄需事先建立：sudo mkdir -p /srv/quote-platform/data && sudo chown "$USER" /srv/quote-platform/data
DATA_ROOT=/srv/quote-platform/data

# 保持 false；有 schema 變更時用 deploy.sh --migrate 單次套用
MIGRATE_ON_START=false
BOOTSTRAP_ON_START=false
# 全新資料庫（不還原備份）首次部署時必填，建立 admin 用；登入改密碼後清空
BOOTSTRAP_ADMIN_PASSWORD=

# 綁 0.0.0.0 讓區網（Hyper-V 主機、其他電腦）可以直接連；前面若有代理改成 127.0.0.1
WEB_BIND=0.0.0.0
# 不信任任何代理：demo 機沒有前置代理，且 Hyper-V 預設交換器常用 172.x 網段，
# 設成 172.16.0.0/12 會讓從 Hyper-V 主機連進來的人能偽造 X-Forwarded-For 繞過登入節流。
# 之後若在 demo 機前面加 HTTPS 代理，再改成代理的來源 IP。
TRUSTED_PROXY_CIDR=127.0.0.1/32
WEB_PORT=8096
IMAGE_TAG=latest
BACKUP_KEEP_DAYS=7
