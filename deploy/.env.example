# 通用範本，說明各欄位用途。實際部署請複製成對應環境的檔案：
#   .env.development.example → deploy/.env.development   Mac 開發機
#   .env.demo.example        → deploy/.env.demo          Hyper-V Ubuntu demo 機
#   .env.production.example  → deploy/.env.production    正式機
# 然後執行 ./deploy/deploy.sh --environment=<環境>，腳本會把選定的檔案複製成 deploy/.env。
# deploy/.env 與 deploy/.env.<環境> 都不進版控。
#
# 各環境主要差異：DEPLOY_MODE、SHARED_DB_*、DATA_ROOT、REFRESH_COOKIE_SECURE、WEB_BIND、密碼與金鑰。

DEPLOY_MODE=build
SHARED_DB_CONTAINER=mariadb
SHARED_DB_NETWORK=mariadb-network
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me
JWT_KEY=change-me-at-least-32-characters-long
REFRESH_COOKIE_SECURE=true
# 掛在其他網站的子路徑下時填（例如 /quote-platform/app）；留空＝根目錄。
APP_BASE_PATH=
FILE_TOKEN_KEY=change-me-at-least-32-characters-long
FILE_CALLBACK_SECRET=change-me-16-chars-min
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MINIO_ROOT_USER=quote
MINIO_ROOT_PASSWORD=change-me-at-least-8
DATA_ROOT=/srv/quote-platform/data
MIGRATE_ON_START=false
BOOTSTRAP_ON_START=false
BOOTSTRAP_ADMIN_PASSWORD=
WEB_BIND=127.0.0.1
# 信任的前置代理來源（單一 IP 或 CIDR）；沒有前置代理時維持 127.0.0.1/32
TRUSTED_PROXY_CIDR=127.0.0.1/32
WEB_PORT=8096
IMAGE_TAG=latest
BACKUP_KEEP_DAYS=7
