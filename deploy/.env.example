# 複製為 deploy/.env（不進版控）
#
# 共用 MariaDB：
#   Mac 模擬部署：SHARED_DB_CONTAINER=shared-mariadb、SHARED_DB_NETWORK=shared-db
#   demo／VPS   ：SHARED_DB_CONTAINER=mariadb、SHARED_DB_NETWORK=mariadb-network
SHARED_DB_CONTAINER=mariadb
SHARED_DB_NETWORK=mariadb-network

# quote_app 帳號密碼（API 使用）
DB_PASSWORD=change-me
# 共用 MariaDB root 密碼：只給 deploy/ensure-shared-db.sh 與備份腳本，不會傳進 API container
DB_ROOT_PASSWORD=change-me

# 至少 32 字元，可用 openssl rand -base64 48 產生
JWT_KEY=change-me-at-least-32-characters-long
# 前端若不是 HTTPS（例如區網測試）才改成 false
REFRESH_COOKIE_SECURE=true

# 檔案服務（API 與 file-server 共用）
FILE_TOKEN_KEY=change-me-at-least-32-characters-long
FILE_CALLBACK_SECRET=change-me-16-chars-min
# 圖像識別匯入（選用）：金鑰都留空則關閉；照片／掃描檔會送到所選的供應商辨識
# 供應商、模型、強度不在這裡，改 deploy/config/ai-settings.json（存檔即生效）
ANTHROPIC_API_KEY=
# Gemini 建議用付費方案的金鑰（免費方案的內容可能被 Google 用於改善產品）
GEMINI_API_KEY=
# MinIO（本系統專用，不與美達特共用）
MINIO_ROOT_USER=quote
MINIO_ROOT_PASSWORD=change-me-at-least-8
# 正式環境資料目錄：MinIO 資料落在 ${DATA_ROOT}/quote/minio（需先建立）
DATA_ROOT=/srv/quote-platform/data

# 首次部署設為 true 建立權限目錄、系統角色與 admin；完成後改回 false
BOOTSTRAP_ON_START=false
BOOTSTRAP_ADMIN_PASSWORD=

# 後台對外 port（前面再接 TLS 反向代理）
WEB_BIND=127.0.0.1
WEB_PORT=8096
IMAGE_TAG=latest
