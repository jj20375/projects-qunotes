<?xml version="1.0" encoding="UTF-8"?>
<!--
  專案報價管理系統：IIS Application「quote-platform」的反向代理設定（已在 demo 機實測可運作）。
  對外網址 https://<網域>/quote-platform/app/ → demo 機 VM（192.168.84.201）的 web 容器 8096。

  放置位置：IIS 管理員在網站底下「新增應用程式」，別名填 quote-platform，實體路徑指向一個空資料夾
  （例如 C:\inetpub\quote-platform-proxy），把這個檔案放進去。內容全部由 VM 提供，資料夾只是 IIS 要求的實體路徑。

  別名只有 quote-platform，後面的 app 由下面的規則比對：IIS 進到這個 Application 前會先剝掉 /quote-platform，
  所以規則看到的路徑是 app/...。deploy/.env.demo 的 APP_BASE_PATH=/quote-platform/app 必須等於「別名 + app」，
  WEB_BIND=0.0.0.0、WEB_PORT=8096。別名、app、VM IP 或 port 改了，要一起改。

  前置需求（美達特的站台已在同一台 IIS 上用過，通常已經具備）：
  - URL Rewrite 與 Application Request Routing，且 ARR 的 Server Proxy Settings 已勾選 Enable proxy。
  - IIS 已安裝 WebSocket 通訊協定功能（虛擬辦公室的即時連線需要；沒裝時其他功能正常，只是上線狀態不會更新）。

  不帶 X-Forwarded-Proto／Host 也能運作：後端沒有依請求是 http 或 https 決定任何行為，
  refresh cookie 的 Secure 由 REFRESH_COOKIE_SECURE 設定決定。因此也不需要在 URL Rewrite 開放伺服器變數。
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- 只輸入 /quote-platform/ 時帶到 app。 -->
                <rule name="Redirect Root To App" stopProcessing="true">
                    <match url="^$" />
                    <action type="Redirect" url="app" redirectType="Found" />
                </rule>

                <!-- app 之後的部分（含查詢字串）原樣轉給 VM。{R:1} 本身帶開頭的斜線；
                     比對 ^app 開頭，所以 /quote-platform/application 這類相似路徑不會被誤轉。
                     沒寫 appendQueryString：預設就會附上，檔案下載網址的簽章 token 在查詢字串裡。 -->
                <rule name="Reverse Proxy To Backend" stopProcessing="true">
                    <match url="^app(/.*)?$" />
                    <action type="Rewrite" url="http://192.168.84.201:8096{R:1}" />
                </rule>
            </rules>
        </rewrite>

        <!-- timeout：AI 圖像識別匯入最久要等約 5 分鐘（VM 的 nginx 設 330 秒），ARR 預設會先逾時回 502。
             X-Forwarded-For 由 ARR 自動加上，VM 端用 TRUSTED_PROXY_CIDR 決定是否採信。 -->
        <proxy reverseRewriteHostInResponseHeaders="false" preserveHostHeader="true" timeout="00:05:30" />
    </system.webServer>
</configuration>
