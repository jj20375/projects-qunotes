<?xml version="1.0" encoding="UTF-8"?>
<!--
  專案報價管理系統：IIS Application「quote-platform/app」的反向代理設定。
  對外網址 https://<網域>/quote-platform/app/ → demo 機 VM（192.168.84.201）的 web 容器 8096。

  放置位置：IIS 管理員在網站底下「新增應用程式」，別名填 quote-platform/app，實體路徑指向一個空資料夾
  （例如 C:\inetpub\quote-platform-app-proxy），把這個檔案放進去。內容全部由 VM 提供，資料夾只是 IIS 要求的實體路徑。

  必須與 deploy/.env.demo 一致：APP_BASE_PATH=/quote-platform/app、WEB_BIND=0.0.0.0、WEB_PORT=8096。
  別名、VM IP 或 port 改了，下面三個地方要一起改。

  前置需求（美達特的站台已在同一台 IIS 上用過，通常已經具備）：
  - URL Rewrite 與 Application Request Routing，且 ARR 的 Server Proxy Settings 已勾選 Enable proxy。
  - URL Rewrite 的「允許的伺服器變數」包含 HTTP_X_FORWARDED_PROTO、HTTP_X_FORWARDED_HOST。
  - IIS 已安裝 WebSocket 通訊協定功能（虛擬辦公室的即時連線需要；沒裝時其他功能正常，只是上線狀態不會更新）。
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- 輸入 /quote-platform/app（沒有結尾斜線）時補上斜線。加上 {URL} 條件只比對這個裸路徑：
                     不同 IIS 版本對 Application 根目錄的 match url 都可能是空字串，沒有條件時 /quote-platform/app/ 也會被轉址而無限循環。 -->
                <rule name="QuotePlatform - add trailing slash" stopProcessing="true">
                    <match url="^$" />
                    <conditions>
                        <add input="{URL}" pattern="^/quote-platform/app$" />
                    </conditions>
                    <action type="Redirect" url="/quote-platform/app/" redirectType="Permanent" />
                </rule>

                <!-- IIS 進到這個 Application 前已經剝掉 /quote-platform/app，(.*) 是之後的部分，原樣轉給 VM。
                     appendQueryString 不能省：檔案下載網址的簽章 token 在查詢字串裡。 -->
                <rule name="QuotePlatform - reverse proxy" stopProcessing="true">
                    <match url="(.*)" />
                    <serverVariables>
                        <set name="HTTP_X_FORWARDED_PROTO" value="https" />
                        <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
                    </serverVariables>
                    <action type="Rewrite" url="http://192.168.84.201:8096/{R:1}" appendQueryString="true" />
                </rule>
            </rules>
        </rewrite>

        <!-- timeout：AI 圖像識別匯入最久要等約 5 分鐘（VM 的 nginx 設 330 秒），ARR 預設會先逾時回 502。
             X-Forwarded-For 由 ARR 自動加上，VM 端用 TRUSTED_PROXY_CIDR 決定是否採信。 -->
        <proxy reverseRewriteHostInResponseHeaders="false" preserveHostHeader="true" timeout="00:05:30" />
    </system.webServer>
</configuration>
