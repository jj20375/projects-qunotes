# 開發機（Mac）用 Docker 跑完整 stack 的設定。複製為 deploy/.env.development 後填值（不進版控）。
#   ./deploy/deploy.sh --environment=development
#
# 平常開發（dotnet run、npm run dev:*）不經過這份檔案，用根目錄的 .env.development-api.local。

# build：在本機 docker compose build；offline：載入 export-images.sh 打包的 tar
DEPLOY_MODE=build

# 共用 MariaDB：Mac 上是 shared-mariadb（network shared-db，別名 mariadb）。
# 不要用 metat-vps-copy-db（3306），那是美達特的資料。
SHARED_DB_CONTAINER=shared-mariadb
SHARED_DB_NETWORK=shared-db

# quote_app 帳號密碼（API 使用）。必須與 .env.development-api.local 連線字串裡的密碼相同：
# 這裡和 npm run dev:api 用的是同一個 quote_platform，而部署時 ensure-shared-db 會把 quote_app 密碼重設成這個值。
DB_PASSWORD=change-me
# 共用 MariaDB 的 root 密碼：只給 ensure-shared-db 與備份／還原腳本，不會傳進 API 容器
DB_ROOT_PASSWORD=change-me

# 至少 32 字元，可用 openssl rand -base64 48 產生
JWT_KEY=change-me-at-least-32-characters-long
FILE_TOKEN_KEY=change-me-at-least-32-characters-long
FILE_CALLBACK_SECRET=change-me-16-chars-min
# 本機用 http://localhost 存取，Secure cookie 在 Safari 不會被帶上
REFRESH_COOKIE_SECURE=false

# 圖像識別匯入（選用）：金鑰留空則關閉。供應商與模型改 deploy/config/ai-settings.json
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# MinIO（本系統專用，不與美達特共用）
MINIO_ROOT_USER=quote
MINIO_ROOT_PASSWORD=change-me-at-least-8
# MinIO 資料落在 ${DATA_ROOT}/quote/minio
DATA_ROOT=/Users/change-me/docker-volumes

# 啟動時是否自動套用 migration／執行 Seeder。開發機方便起見預設開 migration；
# 其他環境請保持 false，需要時用 deploy.sh --migrate／--bootstrap 做單次套用。
MIGRATE_ON_START=true
BOOTSTRAP_ON_START=false
# Seeder 建立 admin 時的初始密碼（只在 admin 不存在時使用）
BOOTSTRAP_ADMIN_PASSWORD=

WEB_BIND=127.0.0.1
# 不信任任何代理（直接連線，沒有前置代理）
TRUSTED_PROXY_CIDR=127.0.0.1/32
WEB_PORT=8096
IMAGE_TAG=latest
BACKUP_KEEP_DAYS=7
